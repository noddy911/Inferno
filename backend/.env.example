# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/interior-quotation

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP) - used for forgot/reset password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Frontend
CLIENT_URL=http://localhost:3000

# AI Estimation Assistant (design §8.4) - default `mock` needs no key/SDK.
# Set AI_PROVIDER to openai | anthropic | gemini and add the matching key + model.
# The SDK packages are only installed when a real provider is used.
AI_PROVIDER=mock
AI_TIMEOUT_MS=20000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
